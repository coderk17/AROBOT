# LLM (OpenAI-compatible: OpenAI, DeepSeek, Qwen, etc.)
OPENAI_API_KEY=sk-xxx
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small

# Vector store
CHROMA_PERSIST_DIR=./data/chroma
DOCUMENTS_DIR=./data/documents

# WeCom AI Bot (企业微信智能机器人 - 长连接模式)
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# Comma-separated user IDs allowed to use the bot (empty = allow all)
WECOM_ALLOW_FROM=

# MCP report server
# Local dev: leave MCP_REPORT_URL empty → agent spawns stdio subprocess
MCP_REPORT_SERVER_PATH=./mcp_servers/report_server/server.py
# Docker: set by compose → http://mcp-report:8000/mcp
MCP_REPORT_URL=
MCP_REPORT_PORT=8000

# Runtime
UPLOAD_DIR=./data/uploads
LOG_LEVEL=INFO
